extends CanvasLayer
## Title screen overlay (the world keeps drifting around the tree behind it).

signal start_pressed

const Art = preload("res://scripts/art.gd")

var ctrl: Control
var t := 0.0
var active := false
var alpha := 0.0


func _ready() -> void:
	layer = 15
	ctrl = Control.new()
	ctrl.set_anchors_preset(Control.PRESET_FULL_RECT)
	ctrl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(ctrl)
	ctrl.draw.connect(_draw_title)


func show_title() -> void:
	active = true
	visible = true


func hide_title() -> void:
	active = false


func _process(dt: float) -> void:
	t += dt
	alpha = move_toward(alpha, 1.0 if active else 0.0, dt * (1.5 if active else 2.5))
	visible = alpha > 0.0
	if active and alpha > 0.6 and (Input.is_action_just_pressed("accept") or Input.is_action_just_pressed("jump")):
		Audio.play("ui_ok", -4.0)
		start_pressed.emit()
	ctrl.queue_redraw()


func _draw_title() -> void:
	var vs := ctrl.size
	var a := alpha
	var cx := vs.x * 0.5
	ctrl.draw_polygon(PackedVector2Array([Vector2(0, 0), Vector2(vs.x, 0), Vector2(vs.x, 330), Vector2(0, 330)]),
		PackedColorArray([Color(0, 0, 0, 0.7 * a), Color(0, 0, 0, 0.7 * a), Color(0, 0, 0, 0), Color(0, 0, 0, 0)]))
	ctrl.draw_polygon(PackedVector2Array([Vector2(0, vs.y - 260), Vector2(vs.x, vs.y - 260), Vector2(vs.x, vs.y), Vector2(0, vs.y)]),
		PackedColorArray([Color(0, 0, 0, 0), Color(0, 0, 0, 0), Color(0, 0, 0, 0.8 * a), Color(0, 0, 0, 0.8 * a)]))
	# wobbly title
	var title := "EIGHT ARMS UP"
	var f := Art.font()
	var size := 92
	var total := f.get_string_size(title, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x
	var x := cx - total * 0.5
	for i in title.length():
		var ch := title[i]
		var w := f.get_string_size(ch, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x
		var y := 150.0 + sin(t * 2.2 + i * 0.55) * 6.0
		var col := Art.OCTO.lerp(Color("ffb27a"), 0.5 + 0.5 * sin(t * 1.3 + i * 0.4))
		ctrl.draw_string_outline(f, Vector2(x, y), ch, HORIZONTAL_ALIGNMENT_LEFT, -1, size, 14, Color(0.08, 0.03, 0.06, a))
		ctrl.draw_string(f, Vector2(x, y), ch, HORIZONTAL_ALIGNMENT_LEFT, -1, size, Color(col, a))
		x += w
	Art.text_outline(ctrl, Vector2(cx, 206), "Otto und die blaue Zitrone", 34, Color(Color("7fb0ff"), a), Color(0, 0, 0, a * 0.8), 6)
	Art.lemon(ctrl, Vector2(cx + 262, 194), sin(t * 1.4) * 0.3, 1.0)
	Art.text_outline(ctrl, Vector2(cx, 246), "An octopus climbs a 1937 chestnut tree up the light shaft of a hospital car park in Vienna.", 17, Color(0.9, 0.9, 0.85, a * 0.9), Color(0, 0, 0, a * 0.6), 4)
	if active and int(t * 2.0) % 2 == 0:
		Art.text_outline(ctrl, Vector2(cx, vs.y - 196), "Press  SPACE  /  ENTER  /  Click  to start", 24, Color(1, 0.95, 0.75, a), Color(0, 0, 0, a), 5)
	var col1 := [
		"[A] [D]  walk · swim",
		"[W] [S]  climb bark, ivy, pipes",
		"[Space]  jump  (hold = higher)",
	]
	var col2 := [
		"[Left click] / [J]  tentacle — hold to swing",
		"[Right click] / [K] / [Shift]  ink dash",
		"[Esc]  pause        Gamepad works too",
	]
	for i in 3:
		ctrl.draw_string(f, Vector2(cx - 470, vs.y - 136 + i * 28), col1[i], HORIZONTAL_ALIGNMENT_LEFT, -1, 18, Color(0.85, 0.9, 1.0, a * 0.85))
		ctrl.draw_string(f, Vector2(cx + 10, vs.y - 136 + i * 28), col2[i], HORIZONTAL_ALIGNMENT_LEFT, -1, 18, Color(0.85, 0.9, 1.0, a * 0.85))
	Art.text(ctrl, Vector2(cx, vs.y - 26), "Made with Godot · every pixel and every sound is generated by code · music: »Kastanienwalzer«", 13, Color(1, 1, 1, a * 0.4))
