extends Node
## Audio manager (autoload "Audio"). All sounds are procedurally generated by
## tools/gen_audio.py into res://assets/audio/.
##
## Buses:  Music (low-pass + reverb: the 1937 radio heard from far below),
##         SFX (a touch of car-park echo), Amb (ambience loops).

const SFX := [
	"jump", "land", "step", "splash", "swim", "shoot", "attach", "ink", "kastanie",
	"checkpoint", "hurt", "dry", "respawn", "sneeze_ha", "sneeze_tschi", "geyser",
	"flap", "coo", "horn", "drip", "lemon", "blip_squid", "blip_otto", "blip_radio",
	"ui_move", "ui_ok", "climb", "radio_tune", "gust", "gulp", "plop", "fanfare",
]
const LOOPS := [
	"waltz", "amb_garage", "amb_city", "loop_engine", "loop_siren", "loop_fan",
	"loop_vent", "loop_sprinkler", "loop_beep",
]

var _streams := {}
var _pool: Array = []
var _pool2d: Array = []
var _pool_i := 0
var _pool2d_i := 0

var music: AudioStreamPlayer
var amb: AudioStreamPlayer
var amb_city: AudioStreamPlayer
var lowpass: AudioEffectLowPassFilter
var reverb: AudioEffectReverb

var _music_cut := 1200.0
var _music_vol := -6.0
var _amb_vol := -12.0
var _city_vol := -60.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_setup_buses()
	for n in SFX + LOOPS:
		var path := "res://assets/audio/%s.wav" % n
		if ResourceLoader.exists(path):
			_streams[n] = load(path)
	for i in 14:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool.append(p)
	for i in 10:
		var p2 := AudioStreamPlayer2D.new()
		p2.bus = "SFX"
		p2.max_distance = 1500.0
		p2.attenuation = 1.6
		add_child(p2)
		_pool2d.append(p2)
	music = _loop_player("waltz", "Music")
	amb = _loop_player("amb_garage", "Amb")
	amb_city = _loop_player("amb_city", "Amb")
	amb_city.volume_db = -60.0


func _loop_player(n: String, bus: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = bus
	if _streams.has(n):
		p.stream = _streams[n]
	add_child(p)
	return p


func _setup_buses() -> void:
	for b in ["Music", "SFX", "Amb"]:
		if AudioServer.get_bus_index(b) == -1:
			AudioServer.add_bus()
			var i := AudioServer.bus_count - 1
			AudioServer.set_bus_name(i, b)
			AudioServer.set_bus_send(i, "Master")
	var mi := AudioServer.get_bus_index("Music")
	lowpass = AudioEffectLowPassFilter.new()
	lowpass.cutoff_hz = 1200.0
	lowpass.resonance = 0.6
	AudioServer.add_bus_effect(mi, lowpass)
	reverb = AudioEffectReverb.new()
	reverb.room_size = 0.75
	reverb.damping = 0.4
	reverb.wet = 0.22
	reverb.dry = 0.9
	AudioServer.add_bus_effect(mi, reverb)
	var si := AudioServer.get_bus_index("SFX")
	var rv := AudioEffectReverb.new()
	rv.room_size = 0.55
	rv.damping = 0.5
	rv.wet = 0.12
	rv.dry = 1.0
	AudioServer.add_bus_effect(si, rv)
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Amb"), -4.0)


func stream(n: String) -> AudioStream:
	return _streams.get(n, null)


func play(n: String, vol := 0.0, pitch := 1.0, vary := 0.06) -> void:
	if not _streams.has(n):
		return
	var p: AudioStreamPlayer = _pool[_pool_i]
	_pool_i = (_pool_i + 1) % _pool.size()
	p.stream = _streams[n]
	p.volume_db = vol
	p.pitch_scale = maxf(0.05, pitch * (1.0 + randf_range(-vary, vary)))
	p.play()


func play_at(n: String, pos: Vector2, vol := 0.0, pitch := 1.0, vary := 0.06, dist := 1500.0) -> void:
	if not _streams.has(n):
		return
	var p: AudioStreamPlayer2D = _pool2d[_pool2d_i]
	_pool2d_i = (_pool2d_i + 1) % _pool2d.size()
	p.stream = _streams[n]
	p.global_position = pos
	p.max_distance = dist
	p.volume_db = vol
	p.pitch_scale = maxf(0.05, pitch * (1.0 + randf_range(-vary, vary)))
	p.play()


func start_music() -> void:
	if music.stream and not music.playing:
		music.play()
	if amb.stream and not amb.playing:
		amb.play()
	if amb_city.stream and not amb_city.playing:
		amb_city.play()


## Called every frame by the world. t = 0 at the bottom of the car park,
## 1 next to the radio. underwater muffles everything.
func set_listen(t: float, underwater: bool, surface: float) -> void:
	var cut := 260.0 * pow(18000.0 / 260.0, pow(clampf(t, 0.0, 1.0), 1.35))
	if underwater:
		cut = minf(cut, 380.0)
	_music_cut = lerpf(_music_cut, cut, 0.08)
	lowpass.cutoff_hz = _music_cut
	reverb.wet = lerpf(0.3, 0.06, t)
	_music_vol = lerpf(_music_vol, lerpf(-9.0, 0.0, t), 0.05)
	music.volume_db = _music_vol
	_amb_vol = lerpf(_amb_vol, lerpf(-6.0, -40.0, surface), 0.05)
	amb.volume_db = _amb_vol
	_city_vol = lerpf(_city_vol, lerpf(-50.0, -6.0, surface), 0.05)
	amb_city.volume_db = _city_vol


func set_music_enabled(on: bool) -> void:
	AudioServer.set_bus_mute(AudioServer.get_bus_index("Music"), not on)
